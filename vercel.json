{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/pricing",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/services/local-seo-service",
      "destination": "/local-seo",
      "permanent": true
    },
    {
      "source": "/services/local-seo-intake",
      "destination": "/contacts?plan=map-pack-growth",
      "permanent": true
    },
    {
      "source": "/services/cloud-stack-backlinks",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/services/social-signals",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/:country-local-citations",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/:category-category-citations",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/:path*.html",
      "destination": "/:path*",
      "permanent": true
    },
    {
      "source": "/:path*/index",
      "destination": "/:path*",
      "permanent": true
    },
    {
      "source": "/index",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/blog/:slug",
      "destination": "/blog-post.html"
    },
    {
      "source": "/:slug-guide",
      "destination": "/guides/:slug-guide.html"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/pricing",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
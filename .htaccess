# SMBify Agency - Apache Rewrite Rules
# For handling redirects and trailing slashes

# Enable rewrite engine
RewriteEngine On

# Commercial Trade Slugs 301 Redirects
RewriteRule ^plumbing-local-seo-blueprint(?:\.html)?$ /plumbing-seo [R=301,L,NC]
RewriteRule ^hvac-local-seo-guide(?:\.html)?$ /hvac-seo [R=301,L,NC]
RewriteRule ^electrician-seo-guide(?:\.html)?$ /electrical-seo [R=301,L,NC]
RewriteRule ^roofing-local-seo-playbook(?:\.html)?$ /roofing-seo [R=301,L,NC]
RewriteRule ^water-damage-restoration-seo-guide(?:\.html)?$ /water-damage-restoration-seo [R=301,L,NC]
RewriteRule ^garage-door-repair-seo-guide(?:\.html)?$ /garage-door-repair-seo [R=301,L,NC]
RewriteRule ^pest-control-local-seo-guide(?:\.html)?$ /pest-control-seo [R=301,L,NC]
RewriteRule ^lawn-care-landscaping-seo-guide(?:\.html)?$ /lawn-care-landscape-seo [R=301,L,NC]
RewriteRule ^pool-service-local-seo-guide(?:\.html)?$ /pool-service-seo [R=301,L,NC]
RewriteRule ^cleaning-service-local-seo-guide(?:\.html)?$ /cleaning-services-seo [R=301,L,NC]
RewriteRule ^junk-removal-local-seo-guide(?:\.html)?$ /junk-removal-seo [R=301,L,NC]
RewriteRule ^tree-service-local-seo-guide(?:\.html)?$ /tree-service-seo [R=301,L,NC]
RewriteRule ^chimney-duct-cleaning-seo-guide(?:\.html)?$ /chimney-duct-cleaning-seo [R=301,L,NC]
RewriteRule ^remodeling-contractor-seo-guide(?:\.html)?$ /remodeling-builders-seo [R=301,L,NC]
RewriteRule ^painting-contractor-local-seo-guide(?:\.html)?$ /painting-contractor-seo [R=301,L,NC]
RewriteRule ^flooring-contractor-seo-guide(?:\.html)?$ /flooring-contractor-seo [R=301,L,NC]
RewriteRule ^fencing-contractor-seo-guide(?:\.html)?$ /fencing-contractor-seo [R=301,L,NC]
RewriteRule ^window-door-contractor-seo-guide(?:\.html)?$ /windows-doors-seo [R=301,L,NC]
RewriteRule ^solar-installer-local-seo-guide(?:\.html)?$ /solar-installer-seo [R=301,L,NC]
RewriteRule ^concrete-paving-seo-guide(?:\.html)?$ /concrete-paving-seo [R=301,L,NC]
RewriteRule ^deck-builder-local-seo-guide(?:\.html)?$ /deck-builder-seo [R=301,L,NC]


# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Force www (optional - uncomment if needed)
# RewriteCond %{HTTP_HOST} !^www\. [NC]
# RewriteRule ^(.*)$ https://www.%{HTTP_HOST}/$1 [L,R=301]

# Redirect index.php to homepage
RewriteRule ^index\.php$ / [R=301,L]

# Redirect /index to / (root)
RewriteRule ^index$ / [R=301,L]

# Redirect any path ending with /index to just the directory
# e.g., /marketplace/index -> /marketplace/
RewriteRule ^(.+)/index$ /$1/ [R=301,L]

# Redirect old catalog URL to services
RewriteRule ^catalog$ /services [R=301,L]

# Redirect legacy blog query URLs to clean blog slugs
RewriteCond %{THE_REQUEST} \s/+blog-post(?:\.html)?\? [NC]
RewriteCond %{QUERY_STRING} (^|&)slug=([^&]+) [NC]
RewriteRule ^blog-post(?:\.html)?$ /blog/%2? [R=301,L,NE]

# Remove trailing slashes (except for directories)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)/$ /$1 [R=301,L]

# Add trailing slash to directories (consistency)
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_URI} !/$
RewriteRule ^(.*)$ /$1/ [R=301,L]

# Handle .html extension - SEO clean URLs for deployed site
# Step 1: Redirect .html URLs to clean URLs (301 for SEO)
# This makes /about.html redirect to /about
RewriteCond %{THE_REQUEST} /([^.]+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]



# Step 2: Internally serve .html files when clean URL is requested
# This makes /about serve about.html content
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f

# Redirect citations-by-category to services (clean up legacy pages)
RewriteRule ^([^/]+-category-citations)$ /services [R=301,L]

# Redirect citations-by-country to services (clean up legacy pages)
RewriteRule ^([^/]+-local-citations)$ /services [R=301,L]

# Try guides (Explicitly mapping all 12 pillar pages)
RewriteRule ^(local-seo-guide|local-citations-guide|google-entity-stack-guide|guest-posting-guide|foundational-backlinks-guide|press-release-guide|social-signals-guide|cloud-stack-backlinks-guide|web2-map-embeds-guide|brand-mentions-guide|forum-backlinks-guide|website-design-guide)$ guides/$1.html [L]

# Static cornerstone blog articles
RewriteRule ^blog/google-business-profile-optimization-guide/?$ blog-pages/google-business-profile-optimization-guide.html [L]
RewriteRule ^blog/local-citation-building-for-agencies/?$ blog-pages/local-citation-building-for-agencies.html [L]
RewriteRule ^blog/water-damage-restoration-local-seo/?$ blog-pages/water-damage-restoration-local-seo.html [L]
RewriteRule ^blog/map-pack-ranking-factors/?$ blog-pages/map-pack-ranking-factors.html [L]
RewriteRule ^blog/white-label-seo-for-agencies/?$ blog-pages/white-label-seo-for-agencies.html [L]

# Clean blog post URLs use the dynamic fallback page
RewriteRule ^blog/([^/]+)/?$ blog-post.html?slug=$1 [L,QSA]

RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]

# Custom 404 Error Page
ErrorDocument 404 /404.html

# Prevent directory browsing
Options -Indexes

# Enable GZIP compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# Browser caching
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
</IfModule>

# Security Headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

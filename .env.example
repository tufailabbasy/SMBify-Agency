# ===============================================
# SMBify Agency - Environment Configuration
# ===============================================
# Copy this file to .env.local for local development
# IMPORTANT: Never commit your actual .env file to Git!

# -----------------------------------------------
# SUPABASE CONFIGURATION
# -----------------------------------------------
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...your-anon-key

# -----------------------------------------------
# STRIPE CONFIGURATION (for Marketplace)
# -----------------------------------------------
# Get these from: https://dashboard.stripe.com/apikeys

STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# -----------------------------------------------
# APPLICATION SETTINGS
# -----------------------------------------------
APP_NAME=SMBify Agency
CURRENCY=USD
CURRENCY_SYMBOL=$

# -----------------------------------------------
# DOMAIN CONFIGURATION
# -----------------------------------------------
# Your live website domain (for production)
PRODUCTION_DOMAIN=https://smbify.agency

# Local development URL
LOCAL_DOMAIN=http://localhost:5500

# -----------------------------------------------
# GROQ AI CONFIGURATION (for AI Chatbot — FREE)
# -----------------------------------------------
# Get your FREE API key at: https://console.groq.com
# Free tier: 14,400 requests/day, Llama 3.3 70B model
# No credit card required for free tier
GROQ_API_KEY=gsk_your_groq_api_key_here

# OPENAI (legacy — no longer used, kept for reference)
# OPENAI_API_KEY=sk-your_openai_api_key_here
